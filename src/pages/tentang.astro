---
// src/pages/tentang.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tentang Kami">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container header-container">
      <span class="badge">Profil Lengkap</span>
      <h1>Tentang Desa Persiapan Oenali</h1>
      <p>Mengenal sejarah pembentukan, kepemimpinan transisi, visi misi, dan batas wilayah kami.</p>
    </div>
  </section>

  <!-- Sejarah Pemekaran -->
  <section class="section">
    <div class="container history-container">
      <div class="history-content">
        <h2>Sejarah Pemekaran Desa</h2>
        <p>
          Desa Persiapan Oenali merupakan hasil pemekaran dari Desa Induk Oenali Utama. Proses pembentukan desa persiapan ini didasari oleh kebutuhan percepatan pelayanan publik, pemerataan pembangunan, dan menimbang pertumbuhan penduduk yang cukup pesat di wilayah selatan desa induk.
        </p>
        <p>
          Berdasarkan Peraturan Bupati No. XX Tahun 202X tentang Pembentukan Desa Persiapan, wilayah ini resmi menjalankan fungsi administratif persiapan guna memenuhi syarat kelayakan menjadi desa definitif dalam kurun waktu 1 hingga 3 tahun ke depan.
        </p>
        <p>
          Selama masa transisi, seluruh pembiayaan operasional dan pengawasan proses pembentukan didukung oleh Pemerintah Kabupaten serta Desa Induk Oenali Utama.
        </p>
      </div>
      <div class="history-visual-placeholder">
        <span class="placeholder-icon">📜</span>
        <span class="placeholder-label">Dokumen / Foto Peresmian Desa Persiapan</span>
      </div>
    </div>
  </section>

  <!-- Visi & Misi -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Visi & Misi</h2>
        <p class="section-subtitle">Arah kebijakan pembangunan dan program kerja selama masa persiapan.</p>
      </div>

      <div class="vision-mission-grid">
        <div class="vision-box">
          <h3>Visi Desa</h3>
          <p class="vision-text">
            "Mewujudkan transisi administrasi yang bersih, cepat, dan transparan menuju Desa Oenali yang Mandiri, Sejahtera, dan Berkelanjutan."
          </p>
        </div>

        <div class="mission-box">
          <h3>Misi Desa</h3>
          <ol class="mission-list">
            <li>Mempercepat penyiapan sarana dan prasarana operasional pemerintahan desa.</li>
            <li>Mengoptimalkan kualitas pelayanan administrasi kepada masyarakat pada masa transisi.</li>
            <li>Melakukan validasi data kependudukan secara menyeluruh dan transparan.</li>
            <li>Menggali potensi lokal di bidang pertanian, peternakan, dan usaha mikro demi kemandirian ekonomi desa masa depan.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Struktur Organisasi -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Struktur Organisasi Sementara</h2>
        <p class="section-subtitle">Susunan pengurus pemerintahan transisi Desa Persiapan Oenali.</p>
      </div>

      <div class="org-chart-placeholder">
        <div class="org-node leader-node">
          <span class="org-role">Penjabat Kepala Desa</span>
          <span class="org-name">Yohanis L. Doe, S.Sos</span>
        </div>
        
        <div class="org-connector-vertical"></div>

        <div class="org-row">
          <div class="org-node">
            <span class="org-role">Sekretaris Desa</span>
            <span class="org-name">Lorem Ipsum, A.Ma</span>
          </div>
          <div class="org-node">
            <span class="org-role">Ketua BPD Persiapan</span>
            <span class="org-name">Dolor Sit Amet, S.T</span>
          </div>
        </div>

        <div class="org-connector-vertical"></div>

        <div class="org-row-cards">
          <div class="org-node card-node">
            <span class="org-role">Kaur Pemerintahan</span>
            <span class="org-name">Staff A</span>
          </div>
          <div class="org-node card-node">
            <span class="org-role">Kaur Keuangan</span>
            <span class="org-name">Staff B</span>
          </div>
          <div class="org-node card-node">
            <span class="org-role">Kaur Umum</span>
            <span class="org-name">Staff C</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Peta & Batas Wilayah -->
  <section class="section section-alt">
    <div class="container map-section-container">
      <div class="map-placeholder">
        <span class="map-icon">🗺️</span>
        <span class="map-label">Peta Google Maps / Batas Wilayah Kartografis</span>
      </div>
      <div class="map-info">
        <h2>Batas Wilayah Administratif</h2>
        <p>
          Berdasarkan hasil musyawarah kesepakatan tata batas desa, Desa Persiapan Oenali memiliki batas-batas administratif sementara sebagai berikut:
        </p>
        <ul class="borders-list">
          <li><strong>Sebelah Utara:</strong> Berbatasan langsung dengan Desa Induk Oenali Utama.</li>
          <li><strong>Sebelah Selatan:</strong> Berbatasan dengan Hutan Lindung Negara / Selat Laut.</li>
          <li><strong>Sebelah Timur:</strong> Berbatasan dengan Desa Contoh Timur.</li>
          <li><strong>Sebelah Barat:</strong> Berbatasan dengan Desa Tetangga Barat.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Header styling */
  .page-header {
    background: linear-gradient(135deg, rgba(21, 128, 61, 0.08) 0%, rgba(248, 250, 252, 1) 100%);
    padding: 5rem 0;
    text-align: center;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .header-container h1 {
    font-size: 2.75rem;
    color: var(--primary-dark);
    margin: 1rem 0;
  }

  .header-container p {
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
    color: var(--neutral-600);
  }

  /* History Styling */
  .history-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .history-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--primary-dark);
  }

  .history-visual-placeholder {
    height: 350px;
    background: linear-gradient(135deg, var(--neutral-100) 0%, rgba(21, 128, 61, 0.05) 100%);
    border: 2px dashed rgba(226, 232, 240, 1);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--neutral-600);
    text-align: center;
    padding: 2rem;
  }

  .history-visual-placeholder .placeholder-icon {
    font-size: 4rem;
  }

  .history-visual-placeholder .placeholder-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Vision & Mission Styling */
  .vision-mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .vision-box, .mission-box {
    background-color: var(--neutral-50);
    padding: 3rem;
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .vision-box h3, .mission-box h3 {
    font-size: 1.5rem;
    color: var(--primary-dark);
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .vision-text {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--neutral-800);
    line-height: 1.6;
  }

  .mission-list {
    padding-left: 1.25rem;
  }

  .mission-list li {
    margin-bottom: 1rem;
    color: var(--neutral-700);
  }

  /* Org Chart Styling */
  .org-chart-placeholder {
    background-color: var(--neutral-50);
    border-radius: 1rem;
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .org-node {
    background-color: var(--neutral-100);
    border: 2px solid var(--primary-light);
    border-radius: 0.75rem;
    padding: 1rem 2rem;
    text-align: center;
    width: 250px;
    box-shadow: var(--shadow-sm);
  }

  .leader-node {
    background-color: var(--primary);
    border-color: var(--primary-dark);
  }

  .leader-node .org-role {
    color: rgba(255, 255, 255, 0.8);
  }

  .leader-node .org-name {
    color: white;
  }

  .org-role {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--primary-dark);
    margin-bottom: 0.25rem;
  }

  .org-name {
    display: block;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--neutral-900);
  }

  .org-connector-vertical {
    width: 2px;
    height: 30px;
    background-color: rgba(21, 128, 61, 0.3);
    margin: 0.5rem 0;
  }

  .org-row {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .org-row-cards {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .card-node {
    width: 200px;
    border-color: var(--neutral-600);
  }

  .card-node .org-role {
    color: var(--neutral-600);
  }

  /* Map section styling */
  .map-section-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .map-placeholder {
    height: 350px;
    background: linear-gradient(135deg, var(--neutral-100) 0%, rgba(21, 128, 61, 0.05) 100%);
    border: 2px dashed rgba(226, 232, 240, 1);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--neutral-600);
  }

  .map-placeholder .map-icon {
    font-size: 4rem;
  }

  .map-placeholder .map-label {
    font-weight: 600;
  }

  .map-info h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--primary-dark);
  }

  .borders-list {
    list-style: none;
    margin-top: 1.5rem;
  }

  .borders-list li {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .borders-list li::before {
    content: '📍';
    position: absolute;
    left: 0;
    top: 2px;
    font-size: 0.95rem;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .history-container, .map-section-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .vision-mission-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
