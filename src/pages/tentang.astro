---
// src/pages/tentang.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tentang Kami">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container header-container">
      <span class="badge">Profil Lengkap</span>
      <h1>Tentang Desa Persiapan Oenali</h1>
      <p>Mengenal asal-usul nama, sejarah pemekaran, kepemimpinan transisi, data dusun, dan batas wilayah kami.</p>
    </div>
  </section>

  <!-- Asal Usul Nama & Sejarah Pemekaran -->
  <section class="section">
    <div class="container history-container">
      <div class="history-content">
        <span class="welcome-label">ASAL-USUL NAMA</span>
        <h2>Legenda Nama "Oenali"</h2>
        <p>
          Nama <strong>Oenali</strong> diambil dari bahasa Dawan (Uab Meto), yaitu kata <strong>"Oe"</strong> yang berarti Air dan <strong>"Nali"</strong> yang berarti Keladi atau Talas.
        </p>
        <p>
          Menurut penuturan sejarah dari tokoh adat setempat, dahulu kala seorang tokoh adat bernama <strong>Naftali Maubanu</strong> bersama para tetua mengisahkan bahwa figur leluhur <strong>Kolo Maubanu</strong> pergi berburu musang di daerah ini. Dalam perburuannya, ia menemukan sebuah sumber mata air yang melimpah dan dikelilingi oleh tanaman talas/keladi liar yang tumbuh subur. Penemuan sumber air (<em>Oe</em>) dan keladi (<em>Nali</em>) inilah yang menjadi asal-usul penamaan wilayah <strong>Oenali</strong>.
        </p>

        <hr class="section-divider" />

        <span class="welcome-label">SEJARAH PEMEKARAN</span>
        <h2>Perjalanan Pemekaran Desa</h2>
        <p>
          Desa Persiapan Oenali secara administratif dimekarkan dari <strong>Desa Induk Mnelalete</strong>, Kecamatan Amanuban Barat, Kabupaten Timor Tengah Selatan. Pemekaran ini didasari oleh aspirasi warga Dusun C Oenali yang memiliki letak geografis cukup jauh dari pusat pelayanan desa induk, serta jumlah penduduk yang telah memenuhi syarat untuk menjadi desa mandiri.
        </p>
        <p>
          Proses pemekaran resmi dimulai dengan diadakannya <strong>Musyawarah Desa (Musdes) Mnelalete pada tanggal 5 September 2023</strong> yang dituangkan dalam Berita Acara Nomor <em>16.02.53.55.07.1004.01.IX.2023</em>. Langkah ini kemudian diperkuat oleh <strong>Surat Keputusan Kepala Desa Mnelalete (Ismael Tefnay) Nomor 06 Tahun 2023</strong> tentang Pembentukan Panitia Pemekaran.
        </p>
        <p>
          Usulan pemekaran ini mendapat dukungan penuh secara resmi melalui <strong>Surat Rekomendasi Camat Amanuban Barat (Steven A. Neonufa, S.Pi)</strong> dengan nomor <em>16.02.53.07.02/145/448/2023</em> pada 8 September 2023 demi mendekatkan pelayanan administratif dan mempercepat laju pembangunan daerah.
        </p>
      </div>
      <div class="history-sidebar">
        <div class="legal-card">
          <span class="card-icon">📜</span>
          <h3>Berkas Legalitas Resmi</h3>
          <ul class="legal-list">
            <li>
              <strong>SK Kades Mnelalete:</strong>
              <span>Nomor 06 Tahun 2023</span>
            </li>
            <li>
              <strong>Berita Acara Musdes:</strong>
              <span>5 September 2023</span>
            </li>
            <li>
              <strong>Rekomendasi Camat:</strong>
              <span>8 September 2023</span>
            </li>
            <li>
              <strong>Hibah Lahan Kantor:</strong>
              <span>1.050 m² oleh Bpk. Naftali Maubanu</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Demografi & Data Dusun -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Wilayah & Demografi Dusun</h2>
        <p class="section-subtitle">Peta demografis rinci dari 4 dusun yang tergabung dalam wilayah administratif Desa Persiapan Oenali.</p>
      </div>

      <div class="dusun-grid">
        <div class="dusun-card">
          <div class="dusun-header">
            <span class="dusun-badge">Dusun I</span>
            <h3>Oenali</h3>
          </div>
          <p class="dusun-role">Pusat Pemerintahan / Ibukota Calon Desa</p>
          <div class="dusun-stats">
            <div class="stat-item">
              <span class="stat-num">904</span>
              <span class="stat-label">Jiwa</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">124</span>
              <span class="stat-label">KK</span>
            </div>
          </div>
        </div>

        <div class="dusun-card">
          <div class="dusun-header">
            <span class="dusun-badge">Dusun II</span>
            <h3>Tubunaus</h3>
          </div>
          <p class="dusun-role">Wilayah Pendukung Publik</p>
          <div class="dusun-stats">
            <div class="stat-item">
              <span class="stat-num">644</span>
              <span class="stat-label">Jiwa</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">117</span>
              <span class="stat-label">KK</span>
            </div>
          </div>
        </div>

        <div class="dusun-card">
          <div class="dusun-header">
            <span class="dusun-badge">Dusun III</span>
            <h3>Netu Ayo</h3>
          </div>
          <p class="dusun-role">Wilayah Potensi Pertanian</p>
          <div class="dusun-stats">
            <div class="stat-item">
              <span class="stat-num">573</span>
              <span class="stat-label">Jiwa</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">97</span>
              <span class="stat-label">KK</span>
            </div>
          </div>
        </div>

        <div class="dusun-card">
          <div class="dusun-header">
            <span class="dusun-badge">Dusun IV</span>
            <h3>Meokono</h3>
          </div>
          <p class="dusun-role">Wilayah Potensi Peternakan</p>
          <div class="dusun-stats">
            <div class="stat-item">
              <span class="stat-num">458</span>
              <span class="stat-label">Jiwa</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">79</span>
              <span class="stat-label">KK</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visi & Misi -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Visi & Misi</h2>
        <p class="section-subtitle">Komitmen arah kebijakan pembangunan selama masa transisi desa persiapan.</p>
      </div>

      <div class="vision-mission-grid">
        <div class="vision-box">
          <h3>Visi Desa</h3>
          <p class="vision-text">
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."
          </p>
        </div>

        <div class="mission-box">
          <h3>Misi Desa</h3>
          <ol class="mission-list">
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
            <li>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</li>
            <li>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</li>
            <li>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Sarana & Prasarana Penunjang -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Sarana & Prasarana Wilayah</h2>
        <p class="section-subtitle">Daftar fasilitas publik yang sudah tersedia di kawasan Desa Persiapan Oenali.</p>
      </div>

      <div class="facilities-grid">
        <div class="facility-category">
          <h3>🏢 Sarana Pemerintahan</h3>
          <ul>
            <li>Kantor Pelayanan Desa Sementara</li>
            <li>Kantor Dinas Pekerjaan Umum Kabupaten TTS</li>
            <li>Kebun Dinas Pertanian & Perkebunan TTS</li>
          </ul>
        </div>
        <div class="facility-category">
          <h3>🏫 Sarana Pendidikan</h3>
          <ul>
            <li>TK Binaan Oenali</li>
            <li>PAUD Imanuel Oenali</li>
            <li>SD Inpres Oenali</li>
            <li>SMP Kencana Sakti Oenali</li>
            <li>SMK Kencana Sakti Oenali</li>
          </ul>
        </div>
        <div class="facility-category">
          <h3>🩺 Kesehatan & Keagamaan</h3>
          <ul>
            <li>Posyandu Oenali 1</li>
            <li>Posyandu Oenali 2</li>
            <li>Gereja Imanuel Oenali</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Peta & Batas Wilayah -->
  <section class="section">
    <div class="container map-section-container">
      <div class="map-placeholder">
        <span class="map-icon">🗺️</span>
        <span class="map-label">Sketsa Batas Wilayah Calon Desa</span>
      </div>
      <div class="map-info">
        <h2>Batas Wilayah Administratif</h2>
        <p>
          Sesuai dengan kesepakatan tata batas dalam <strong>Berita Acara Pemerintahan Desa Mnelalete Tahun 2023</strong>, batas wilayah Desa Persiapan Oenali ditentukan secara geografis sebagai berikut:
        </p>
        <ul class="borders-list">
          <li><strong>Sebelah Utara:</strong> Berbatasan dengan Kelurahan Kobekamusa dan Kelurahan Nunumeu.</li>
          <li><strong>Sebelah Selatan:</strong> Berbatasan dengan Desa Mnelalete dan Desa Nifukani.</li>
          <li><strong>Sebelah Timur:</strong> Berbatasan dengan Desa Pusu dan Desa Nulle.</li>
          <li><strong>Sebelah Barat:</strong> Berbatasan dengan Desa Mnelalete.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Header styling */
  .page-header {
    background: linear-gradient(135deg, rgba(21, 128, 61, 0.08) 0%, rgba(248, 250, 252, 1) 100%);
    padding: 5rem 0;
    text-align: center;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .header-container h1 {
    font-size: 2.75rem;
    color: var(--primary-dark);
    margin: 1rem 0;
  }

  .header-container p {
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
    color: var(--neutral-600);
  }

  /* History Styling */
  .history-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: start;
  }

  .welcome-label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .history-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--primary-dark);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: rgba(226, 232, 240, 1);
    margin: 3rem 0;
  }

  .history-sidebar {
    position: sticky;
    top: 100px;
  }

  /* Legal Card styling */
  .legal-card {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 1rem;
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .legal-card h3 {
    font-size: 1.3rem;
    color: var(--primary-dark);
    margin: 0.75rem 0 1.5rem 0;
  }

  .card-icon {
    font-size: 3rem;
    display: block;
  }

  .legal-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .legal-list li {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed rgba(226, 232, 240, 0.8);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .legal-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .legal-list li strong {
    font-size: 0.85rem;
    color: var(--neutral-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-list li span {
    font-size: 1rem;
    color: var(--neutral-900);
    font-weight: 600;
  }

  /* Dusun Grid Styling */
  .dusun-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .dusun-card {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    border-top: 4px solid var(--primary-light);
  }

  .dusun-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-top-color: var(--accent);
  }

  .dusun-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .dusun-badge {
    background-color: var(--accent-light);
    color: #b45309;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    align-self: flex-start;
    text-transform: uppercase;
  }

  .dusun-card h3 {
    font-size: 1.5rem;
    color: var(--primary-dark);
    margin: 0;
  }

  .dusun-role {
    font-size: 0.85rem;
    color: var(--neutral-600);
    margin-bottom: 2rem;
    flex-grow: 1;
    line-height: 1.4;
  }

  .dusun-stats {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
    padding-top: 1.25rem;
    gap: 1rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .stat-item:first-child {
    border-right: 1px solid rgba(226, 232, 240, 0.8);
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-dark);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--neutral-600);
    font-weight: 600;
    margin-top: 0.25rem;
  }

  /* Vision & Mission Styling */
  .vision-mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .vision-box, .mission-box {
    background-color: var(--neutral-50);
    padding: 3rem;
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .vision-box h3, .mission-box h3 {
    font-size: 1.5rem;
    color: var(--primary-dark);
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .vision-text {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--neutral-800);
    line-height: 1.6;
  }

  .mission-list {
    padding-left: 1.25rem;
  }

  .mission-list li {
    margin-bottom: 1rem;
    color: var(--neutral-700);
  }

  /* Facilities Grid Styling */
  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .facility-category {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  .facility-category h3 {
    font-size: 1.25rem;
    color: var(--primary-dark);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(21, 128, 61, 0.1);
  }

  .facility-category ul {
    list-style: none;
  }

  .facility-category li {
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    position: relative;
    font-size: 0.95rem;
    color: var(--neutral-700);
  }

  .facility-category li::before {
    content: '•';
    color: var(--primary);
    font-size: 1.5rem;
    position: absolute;
    left: 0;
    top: -4px;
  }

  /* Map section styling */
  .map-section-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .map-placeholder {
    height: 350px;
    background: linear-gradient(135deg, var(--neutral-100) 0%, rgba(21, 128, 61, 0.05) 100%);
    border: 2px dashed rgba(226, 232, 240, 1);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--neutral-600);
  }

  .map-placeholder .map-icon {
    font-size: 4rem;
  }

  .map-placeholder .map-label {
    font-weight: 600;
  }

  .map-info h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--primary-dark);
  }

  .borders-list {
    list-style: none;
    margin-top: 1.5rem;
  }

  .borders-list li {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .borders-list li::before {
    content: '📍';
    position: absolute;
    left: 0;
    top: 2px;
    font-size: 0.95rem;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .history-container, .map-section-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .dusun-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vision-mission-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 576px) {
    .dusun-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
