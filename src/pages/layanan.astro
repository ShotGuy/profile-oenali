---
// src/pages/layanan.astro
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    question: "Bagaimana cara mengurus KTP atau KK dengan alamat Desa Persiapan Oenali?",
    answer: "Untuk saat ini, pengurusan administrasi kependudukan (KTP/KK) secara resmi masih menggunakan nama Desa Induk Oenali Utama. Namun, surat pengantar awal dapat diajukan di kantor Desa Persiapan Oenali untuk diverifikasi oleh pejabat desa setempat sebelum dibawa ke desa induk."
  },
  {
    question: "Di mana alamat kantor pelayanan Desa Persiapan Oenali?",
    answer: "Kantor pelayanan sementara berlokasi di Jl. Raya Oenali No. 01 (gedung posko terpadu lama). Kami melayani masyarakat setiap hari kerja dari pukul 08.00 hingga 14.00 WITA."
  },
  {
    question: "Kapan status Desa Persiapan Oenali akan berubah menjadi Desa Definitif?",
    answer: "Perubahan status menjadi desa definitif bergantung pada evaluasi berkala oleh Pemerintah Daerah dan Provinsi dalam kurun waktu 1 hingga 3 tahun sejak diresmikan. Evaluasi mencakup penyediaan fasilitas kantor, jumlah penduduk, efisiensi pelayanan, dan batas tata wilayah."
  },
  {
    question: "Apakah surat keterangan usaha (SKU) bisa diterbitkan langsung oleh Desa Persiapan?",
    answer: "Surat Keterangan Usaha (SKU) sementara akan dirancang dan ditandatangani oleh Penjabat Kepala Desa Persiapan Oenali, namun untuk keperluan perbankan atau legalitas tinggi tetap melampirkan pengesahan dari Kepala Desa Induk Oenali Utama."
  }
];
---

<Layout title="Layanan & FAQ">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container header-container">
      <span class="badge">Panduan Warga</span>
      <h1>Layanan Publik & FAQ</h1>
      <p>Panduan pengurusan berkas administrasi selama masa transisi serta jawaban atas pertanyaan umum warga.</p>
    </div>
  </section>

  <!-- Layanan Administrasi -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Alur Pengurusan Administrasi</h2>
        <p class="section-subtitle">Bagaimana mengurus surat-menyurat di wilayah Desa Persiapan.</p>
      </div>

      <div class="services-flow-grid">
        <div class="flow-card">
          <div class="flow-step">1</div>
          <h3>Ajukan Berkas di Kantor Persiapan</h3>
          <p>Bawa dokumen persyaratan (KTP lama/KK/Surat Pengantar RT) ke Kantor Desa Persiapan Oenali untuk diperiksa kelengkapannya.</p>
        </div>

        <div class="flow-arrow-horizontal">➡️</div>

        <div class="flow-card">
          <div class="flow-step">2</div>
          <h3>Verifikasi & Surat Pengantar</h3>
          <p>Pejabat Desa Persiapan akan memvalidasi data Anda dan mengeluarkan surat pengantar resmi yang ditujukan ke Desa Induk.</p>
        </div>

        <div class="flow-arrow-horizontal">➡️</div>

        <div class="flow-card">
          <div class="flow-step">3</div>
          <h3>Pengesahan di Desa Induk</h3>
          <p>Bawa surat pengantar ke Kantor Desa Induk Oenali Utama untuk ditandatangani oleh Kepala Desa definitif/camat setempat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-alt">
    <div class="container faq-container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Pertanyaan yang Sering Diajukan</h2>
        <p class="section-subtitle">Menjawab kekhawatiran dan kebingungan warga mengenai masa pemekaran desa.</p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <div class="faq-item">
            <details class="faq-details" open={index === 0}>
              <summary class="faq-question">
                {faq.question}
                <span class="faq-icon-arrow">➕</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kontak Section -->
  <section class="section" id="kontak">
    <div class="container contact-section-grid">
      <div class="contact-info-block">
        <h2>Hubungi Kami</h2>
        <p>Ada kendala dengan pelayanan atau ingin memberikan saran pembangunan desa? Sampaikan kepada kami melalui kanal resmi berikut:</p>
        
        <div class="contact-details-list">
          <div class="contact-detail-item">
            <span class="icon">💬</span>
            <div>
              <h4>WhatsApp Layanan Warga</h4>
              <p>+62 812-3456-7890</p>
            </div>
          </div>
          <div class="contact-detail-item">
            <span class="icon">✉️</span>
            <div>
              <h4>Email Resmi</h4>
              <p>info@desaoenali.id</p>
            </div>
          </div>
          <div class="contact-detail-item">
            <span class="icon">🏢</span>
            <div>
              <h4>Kantor Sementara</h4>
              <p>Jl. Raya Oenali No. 01, Kecamatan Oenali</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-block">
        <h3>Formulir Saran / Aspirasi</h3>
        <p class="form-sub">Formulir ini bersifat statis (simulasi). Di masa depan dapat dihubungkan ke email atau WhatsApp.</p>
        
        <form class="mock-form" onsubmit="event.preventDefault(); alert('Aspirasi Anda berhasil dikirim (simulasi)!');">
          <div class="form-group">
            <label for="name">Nama Lengkap</label>
            <input type="text" id="name" placeholder="Nama Anda..." required />
          </div>
          <div class="form-group">
            <label for="email">Alamat Email / Nomor HP</label>
            <input type="text" id="email" placeholder="Kontak Anda..." required />
          </div>
          <div class="form-group">
            <label for="message">Pesan / Aspirasi</label>
            <textarea id="message" rows="4" placeholder="Tulis aspirasi atau saran untuk kemajuan desa..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Kirim Aspirasi</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Header styling */
  .page-header {
    background: linear-gradient(135deg, rgba(21, 128, 61, 0.08) 0%, rgba(248, 250, 252, 1) 100%);
    padding: 5rem 0;
    text-align: center;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .header-container h1 {
    font-size: 2.75rem;
    color: var(--primary-dark);
    margin: 1rem 0;
  }

  .header-container p {
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
    color: var(--neutral-600);
  }

  /* Services Flow Styling */
  .services-flow-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .flow-card {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    flex: 1;
    position: relative;
  }

  .flow-step {
    width: 40px;
    height: 40px;
    background-color: var(--accent);
    color: var(--neutral-900);
    border-radius: 50%;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem auto;
    font-size: 1.15rem;
  }

  .flow-card h3 {
    font-size: 1.2rem;
    color: var(--primary-dark);
    margin-bottom: 0.75rem;
  }

  .flow-card p {
    font-size: 0.95rem;
    color: var(--neutral-600);
    line-height: 1.5;
  }

  .flow-arrow-horizontal {
    font-size: 1.5rem;
    color: var(--primary);
  }

  /* FAQ Styling */
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .faq-details {
    padding: 1.25rem 1.5rem;
  }

  .faq-question {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--neutral-900);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon-arrow {
    font-size: 0.85rem;
    color: var(--primary);
    transition: var(--transition-smooth);
  }

  .faq-details[open] .faq-icon-arrow {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(226, 232, 240, 0.5);
  }

  .faq-answer p {
    color: var(--neutral-700);
    margin-bottom: 0;
  }

  /* Contact section styling */
  .contact-section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }

  .contact-info-block h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .contact-details-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-detail-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .contact-detail-item .icon {
    font-size: 1.75rem;
    background-color: rgba(21, 128, 61, 0.08);
    width: 50px;
    height: 50px;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-detail-item h4 {
    margin-bottom: 0.25rem;
  }

  .contact-detail-item p {
    color: var(--neutral-600);
    margin-bottom: 0;
  }

  /* Form Styling */
  .contact-form-block {
    background-color: var(--neutral-50);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 1rem;
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .contact-form-block h3 {
    font-size: 1.4rem;
    margin-bottom: 0.25rem;
  }

  .form-sub {
    font-size: 0.85rem;
    color: var(--neutral-600);
    margin-bottom: 2rem;
  }

  .mock-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--neutral-800);
  }

  .form-group input, .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(203, 213, 225, 1);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.15);
  }

  .btn-block {
    width: 100%;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .services-flow-grid {
      flex-direction: column;
      gap: 2rem;
    }

    .flow-arrow-horizontal {
      transform: rotate(90deg);
    }

    .contact-section-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
</style>
