---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Website Resmi Desa Persiapan Oenali. Dapatkan informasi terkini mengenai pelayanan, administrasi, berita, dan pembangunan desa." } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Desa Persiapan Oenali</title>
    <meta name="title" content={`${title} | Desa Persiapan Oenali`} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Desa Persiapan Oenali`} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | Desa Persiapan Oenali`} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Structured Data for Google SEO & Sitelinks -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Desa Persiapan Oenali",
        "url": "https://oenali.web.id",
        "description": "Website Resmi Desa Persiapan Oenali, Kecamatan Amanuban Barat, Kabupaten Timor Tengah Selatan."
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "GovernmentOrganization",
        "name": "Pemerintah Desa Persiapan Oenali",
        "alternateName": "Desa Persiapan Oenali",
        "url": "https://oenali.web.id",
        "logo": "https://oenali.web.id/logo.jpg",
        "description": "Pelayanan publik transisi dan informasi resmi pembangunan Desa Persiapan Oenali.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Mnelalete",
          "addressLocality": "Kec. Amanuban Barat",
          "addressRegion": "Kab. Timor Tengah Selatan, Nusa Tenggara Timur",
          "addressCountry": "ID"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+62-812-3456-7890",
          "contactType": "customer service"
        }
      }
    </script>
  </head>
  <body>
    <Navbar />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex-grow: 1;
    min-height: calc(100vh - var(--header-height) - 400px); /* Adjust based on navbar/footer height */
  }
</style>
